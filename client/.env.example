# Optional. Without these only the demo account works.
# Supabase → Project settings → API. The anon key is safe in the browser (the service-role key is NOT).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed if the API is hosted on a different origin than the client.
# In dev the Vite proxy forwards /api to http://localhost:8787.
VITE_API_URL=
