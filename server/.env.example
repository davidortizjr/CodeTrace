# Port the API listens on
PORT=8787

# Where the React app runs (CORS). Comma-separate several origins if needed.
CLIENT_ORIGIN=http://localhost:5173

# Supabase (optional: without these only the demo account works).
# Project settings → API. The service-role key is a SECRET: server only, never in the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (optional: without it every screen still works with built-in wording).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
